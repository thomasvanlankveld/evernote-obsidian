# Evernote API credentials. Copy to `.env` (gitignored) and fill in real values.

# OAuth (Evernote Cloud API consumer key + secret from dev.evernote.com) — required for `login`.
EVERNOTE_CONSUMER_KEY=
EVERNOTE_CONSUMER_SECRET=

# Use the production host; switch to `sandbox.evernote.com` only for API testing.
EVERNOTE_HOST=www.evernote.com

# OAuth redirect URL registered on your API key. Default matches `login` CLI local server.
# EVERNOTE_OAUTH_CALLBACK_URL=http://127.0.0.1:8765/callback

# Optional override for the OAuth token JSON path (default: ./out/evernote-oauth.json under cwd).
# EVERNOTE_OAUTH_TOKEN_PATH=

# Optional: path to your local Obsidian vault. CLI default is `./data`.
# VAULT_PATH=./data

# `evernote-obsidian login` writes `./out/evernote-oauth.json` by default; `snapshot` reads it.
# `evernote-obsidian snapshot` writes `./out/evernote-notes.json` by default (`/out/` is gitignored).
